{
  "_about": "Rules for tools/verify_facts.py (docs/AUTOMATION.md, Fact check). Phrases are matched case-insensitively as regular expressions on word boundaries. 'block' stops the draft; 'warn' is shown for Casey to judge.",
  "block_phrases": [
    {
      "pattern": "\\bown(s|ed|ing)?\\s+(a|the|an)?\\s*p\\s*&\\s*l\\b",
      "why": "Say he manages the engineering budget with Finance, never that he owns a P&L"
    },
    {
      "pattern": "\\bp\\s*&\\s*l\\s+(owner|ownership|responsibility)\\b",
      "why": "Say he manages the engineering budget with Finance, never that he owns a P&L"
    },
    {
      "pattern": "\\bsmartsheet\\b",
      "why": "Never list Smartsheet"
    },
    {
      "pattern": "\\bnetsuite\\b",
      "why": "Never list NetSuite"
    },
    {
      "pattern": "\\bworkday\\b",
      "why": "Never list Workday as a tool",
      "skip_if_company": true
    },
    {
      "pattern": "\\bfinops\\b",
      "why": "Never list FinOps tools"
    },
    {
      "pattern": "\\bcloudhealth\\b|\\bapptio\\b|\\bvantage\\.sh\\b|\\bcloudability\\b",
      "why": "Never list FinOps tools"
    },
    {
      "pattern": "\\bscrum master\\b|\\bSMC\\b|\\bCSM certif",
      "why": "His Scrum Master certification has lapsed; don't list it"
    },
    {
      "pattern": "\\bcornell\\b[^.]{0,40}\\bAI\\b|\\bAI\\b[^.]{0,40}\\bcornell\\b",
      "why": "The Cornell AI coursework is not listed, by Casey's choice"
    },
    {
      "pattern": "\\bowns?\\s+(the\\s+)?company strategy\\b",
      "why": "Overstates his role"
    },
    {
      "pattern": "—|–|(?<=\\w)\\s?--\\s?(?=\\w)",
      "why": "No em-dashes or en-dashes (writing style rule 1)"
    }
  ],
